            {
              "atomType": "Code",
              "x": 0.6,
              "y": 0.4,
              "uniqueID": "id-1265",
              "ioValues": [
                {
                  "name": "shape",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "count",
                  "ioValue": 4
